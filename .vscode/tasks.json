{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (ZB-GW03)",
      "type": "shell",
      "command": "pio run -e zb-gw03",
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Build (WT32-ETH01)",
      "type": "shell",
      "command": "pio run -e wt32-eth01",
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Flash USB (ZB-GW03)",
      "type": "shell",
      "command": "pio run -e zb-gw03 -t upload",
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Flash OTA HTTP (otoskop.local)",
      "type": "shell",
      "command": "pio run -e zb-gw03-http -t upload",
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Flash OTA espota (otoskop.local)",
      "type": "shell",
      "command": "pio run -e zb-gw03-ota -t upload",
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Serial Monitor",
      "type": "shell",
      "command": "pio device monitor",
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "pio run -e zb-gw03 -t clean",
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
